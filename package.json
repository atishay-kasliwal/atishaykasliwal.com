{
  "name": "atishay-kasliwal.github.io",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@emailjs/browser": "^4.4.1",
    "@mlc-ai/web-llm": "^0.2.80",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.10.0",
    "lightgallery": "^2.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-pageflip": "^2.0.3",
    "react-router-dom": "^6.30.1",
    "react-syntax-highlighter": "^16.1.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "npm run content && vite",
    "content": "node scripts/build-content.mjs",
    "github": "node scripts/fetch-github.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/**/*.test.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir .ssr",
    "prerender": "node scripts/prerender.mjs",
    "feeds": "node scripts/generate-feeds.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "postbuild": "(cp public/_redirects build/_redirects 2>/dev/null || true) && (cp public/_headers build/_headers 2>/dev/null || true)",
    "images": "node scripts/build-images.mjs",
    "video": "node scripts/build-video.mjs",
    "build": "npm run images && npm run gallery && npm run content && npm run github && npm run build:client && npm run build:ssr && npm run prerender && npm run feeds && npm run postbuild && npm run check:assets",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write src/**/*.{js,jsx,css}",
    "gallery": "node scripts/build-gallery-dims.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "https://atishaykasliwal.com",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^18.0.9",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "shiki": "^4.4.1",
    "vite": "^6.3.5",
    "wrangler": "^4.45.3"
  }
}
