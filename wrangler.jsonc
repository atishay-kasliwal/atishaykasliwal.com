{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atishay-kasliwal-github-io",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photography",
      "database_id": "3c828611-a65b-48b8-8f35-a1bd9c81b2d6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PHOTO_PUBLIC_BASE": "https://photos.atishaykasliwal.com",
    "ACCESS_TEAM_DOMAIN": "blue-pine-d929.cloudflareaccess.com",
    "ACCESS_AUD": "7449787b940d32dc305d6d18ae710e285610d463f4a292fac7ce8cc38cee4298",
    "ADMIN_EMAILS": "katishay@gmail.com",
    // Client ID of the analytics dashboard's Access service token (not a secret). Empty: no
    // service token is accepted. See functions/_lib/access.js.
    "ADMIN_SERVICE_TOKEN_ID": ""
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "photography-photos"
    },
    {
      // Private: no public domain or r2.dev access. Résumé versions uploaded from /admin/resume;
      // only functions/Atishay-Kasliwal-Resume.pdf.js serves the published one.
      "binding": "RESUMES",
      "bucket_name": "portfolio-resumes"
    }
  ]
}
