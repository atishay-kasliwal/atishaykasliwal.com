rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return
        isSignedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.email == 'katishay@admin.atishaykasliwal.com'
        );
    }

    function validContentType() {
      return
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
        request.resource.contentType.matches('video/(mp4|webm)');
    }

    function validUploadSize() {
      return request.resource.size <= 26214400;
    }

    function validBucketPath(collectionName, year, month, fileName) {
      return
        collectionName in [
          'posts',
          'projects',
          'photos',
          'testimonials',
          'journey',
          'movies',
          'tv',
          'music',
          'media'
        ] &&
        year.matches('^[0-9]{4}$') &&
        month.matches('^[0-9]{2}$') &&
        fileName.matches('^[A-Za-z0-9._-]+$');
    }

    match /cms/{collectionName}/{year}/{month}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validBucketPath(collectionName, year, month, fileName) && validContentType() && validUploadSize();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
