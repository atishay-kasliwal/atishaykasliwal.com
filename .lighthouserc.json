{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/lhci-server.mjs",
      "startServerReadyPattern": "listening",
      "url": [
        "http://127.0.0.1:4318/",
        "http://127.0.0.1:4318/projects/atriveo-tracker/",
        "http://127.0.0.1:4318/projects/insurance-platform/",
        "http://127.0.0.1:4318/projects/fedtalk/",
        "http://127.0.0.1:4318/experience/stony-brook-research/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    }
  }
}
