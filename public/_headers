/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite's hashed bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Project images and videos keep their names when re-recorded, so cache for a day and
# refresh quietly in the background for a week. Only media folders: /projects/<slug>/ is HTML.
/projects/cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/projects/screens/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/projects/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/projects/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# Experience page images follow the same rule. Only the media folder: /experience/<slug>/ is HTML.
/experience/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Photographs rarely change but keep their names when they do: cache for a week, refresh quietly
# for a day. Folders hold only images; the originals are listed one by one because /photography/
# itself is the HTML gallery (scripts/validate-photography.mjs checks every local original is here).
/photography/responsive/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/photography/social/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/photography/rainbow-over-autumn-trees.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/photography/manhattan-skyline-at-dusk.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/photography/sunset-over-parking-lot.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/photography/person-on-rocky-beach-at-sunset.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The public profile API (/api/profile.json and its schema) is generated at build time from
# src/profile/. Same URL across deploys, so a short cache with background refresh; any origin may
# read it, since it is public data meant for tools and agents.
/api/profile.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/api/profile.schema.json
  Content-Type: application/schema+json; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
